generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id               String        @id @default(cuid())
  name             String
  rawConversation  String?
  source           String?
  requirement      String?
  interested       String?
  stage            String?
  tags             String?
  lastAction       String?
  nextAction       String?
  nextFollowDate   DateTime?
  lastDraft        String?
  riskNotes        String?
  notes            String?
  lastReminderDate String?
  followUpLogs     FollowUpLog[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model FollowUpLog {
  id         String   @id @default(cuid())
  customerId String
  action     String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

model Setting {
  id             Int      @id @default(1)
  productContext String?
  aiBaseUrl      String?
  aiAuthToken    String?
  aiModel        String?
  botName        String?
  welcomeMessage String?
  updatedAt      DateTime @updatedAt
}

model KnowledgeDoc {
  id        String   @id @default(cuid())
  title     String
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
